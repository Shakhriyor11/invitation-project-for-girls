# Lokal sinash uchun: bu faylni `.env.local` nomi bilan nusxalang va qiymatlarni to‘ldiring.
# Vercel'da esa shu qiymatlarni Project → Settings → Environment Variables bo‘limiga kiriting.

# @BotFather bergan bot tokeni
TELEGRAM_BOT_TOKEN=

# Hisobot yuboriladigan chat ID (sizning Telegram ID'ingiz, masalan 123456789)
TELEGRAM_CHAT_ID=
